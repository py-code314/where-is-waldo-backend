// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * Models
 */
model Player {
  id   Int    @id @default(autoincrement())
  name String

  // Metadata
  createdAt DateTime @default(now())

  // Relations
  scores Score[]
  scenes Scene[]

  @@map("players")
}

// Limit difficulty to 3 values
enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Scene {
  id          Int        @id @default(autoincrement())
  title       String     @unique
  description String
  difficulty  Difficulty @default(MEDIUM)
  imageUrl    String
  imageAlt    String
  previewUrl  String
  previewAlt  String

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  characters SceneCharacter[]
  scores     Score[]
  player     Player?          @relation(fields: [playerId], references: [id])
  playerId   Int?
  sessions   GameSession[]

  @@map("scenes")
}

model Character {
  id        Int    @id @default(autoincrement())
  name      String @unique
  avatarUrl String

  // Metadata
  createdAt DateTime @default(now())

  // Relations
  scenes SceneCharacter[]

  @@map("characters")
}

// Join table
model SceneCharacter {
  id Int @id @default(autoincrement())

  // Bounding box coordinates are stores as percentages for responsiveness
  minX Float
  maxX Float
  minY Float
  maxY Float

  // Relations
  scene       Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  sceneId     Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId Int

  // Make the combination unique, not the individual fields
  @@unique([sceneId, characterId])
  @@map("scene_characters")
}

model Score {
  id       Int @id @default(autoincrement())
  duration Int

  // Metadata
  createdAt DateTime @default(now())

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId Int
  scene    Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  sceneId  Int

  // Create index for faster query results
  @@index([sceneId, duration])
  @@map("scores")
}

enum GameStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model GameSession {
  id              Int        @id @default(autoincrement())
  startTime       DateTime   @default(now())
  finishTime      DateTime?
  foundCharacters Int[]
  status          GameStatus @default(ACTIVE)

  // Relations
  scene   Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  sceneId Int

  @@map("game_sessions")
}
